generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EMPLOYEE
  CUSTOMER
  DELIVERY
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum Permission {
  VIEW_ORDERS
  MANAGE_ORDERS
  VIEW_PRODUCTS
  MANAGE_PRODUCTS
  VIEW_CUSTOMERS
  MANAGE_CUSTOMERS
  VIEW_DELIVERY
  MANAGE_DELIVERY
  VIEW_CATEGORIES
  MANAGE_CATEGORIES
  VIEW_REPORTS
  MANAGE_HERO
  MANAGE_SETTINGS
  MANAGE_EMPLOYEES
  VIEW_EMPLOYEES
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_DELIVERY
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

model User {
  id                    String                        @id @default(cuid())
  name                  String
  phone                 String
  normalizedPhone       String                        @unique
  email                 String?                       @unique
  passwordHash          String?
  role                  UserRole                      @default(CUSTOMER)
  status                UserStatus                    @default(ACTIVE)
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  sessions              Session[]
  permissions           EmployeePermission[]
  addresses             Address[]
  orders                Order[]
  statusChanges         OrderStatusHistory[]           @relation("OrderStatusChangedBy")
  createdAssignments    DeliveryAssignment[]           @relation("AssignmentCreatedBy")
  deliveryAssignments  DeliveryAssignment[]           @relation("DeliveryPerson")
  assignmentHistory     DeliveryAssignmentHistory[]    @relation("AssignmentHistoryActor")
  previousAssignees     DeliveryAssignmentHistory[]    @relation("PreviousDeliveryPerson")
  nextAssignees         DeliveryAssignmentHistory[]    @relation("NextDeliveryPerson")
  pushSubscriptions     PushSubscription[]

  @@index([role, status])
  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model EmployeePermission {
  id         String     @id @default(cuid())
  userId     String
  permission Permission
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([permission])
}

model Category {
  id          String            @id @default(cuid())
  name        String
  translations Json              @default("{}") @db.JsonB
  slug        String            @unique
  description String?           @db.Text
  imageUrl    String?
  imageCid    String?
  isActive    Boolean           @default(true)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  products    ProductCategory[]

  @@index([isActive, sortOrder])
}

model Product {
  id                    String            @id @default(cuid())
  name                  String
  slug                  String            @unique
  description           String            @db.Text
  translations          Json              @default("{}") @db.JsonB
  shortDescription      String?           @db.VarChar(500)
  tags                  String[]          @default([])
  priceMinor            Int
  originalPriceMinor    Int?
  currency              String            @default("MAD") @db.VarChar(3)
  discountPercent       Decimal?          @db.Decimal(5, 2)
  isOnPromotion         Boolean           @default(false)
  isFeaturedBestSeller  Boolean           @default(false)
  isAvailable           Boolean           @default(true)
  sortOrder             Int               @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  categories            ProductCategory[]
  images                ProductImage[]
  heroSlides            HeroSlide[]
  orderItems            OrderItem[]

  @@index([isAvailable, sortOrder])
  @@index([isOnPromotion, isAvailable, sortOrder])
  @@index([isFeaturedBestSeller, isAvailable, sortOrder])
  @@index([createdAt])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId, productId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  cid       String?
  alt       String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([cid])
}

model HeroSlide {
  id                String    @id @default(cuid())
  title             String
  translations      Json      @default("{}") @db.JsonB
  subtitle          String?
  description       String?   @db.Text
  imageUrl          String
  mobileImageUrl    String?
  imageCid          String?
  mobileImageCid    String?
  ctaText           String?
  ctaDestination    String?
  productId         String?
  product           Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  sortOrder         Int       @default(0)
  isActive          Boolean   @default(true)
  visibleFrom       DateTime?
  visibleUntil      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([isActive, sortOrder])
  @@index([visibleFrom, visibleUntil])
  @@index([productId])
}

model Location {
  id                   String       @id @default(cuid())
  name                 String
  translations         Json         @default("{}") @db.JsonB
  slug                 String       @unique
  deliveryAvailable    Boolean      @default(true)
  deliveryFeeMinor     Int          @default(0)
  minimumOrderMinor    Int          @default(0)
  estimatedMinutes    Int?
  isActive             Boolean      @default(true)
  sortOrder            Int          @default(0)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  addresses            Address[]
  orders               Order[]

  @@index([isActive, deliveryAvailable, sortOrder])
}

model Address {
  id             String   @id @default(cuid())
  userId         String
  locationId     String
  label          String?
  street         String?
  building       String?
  apartment      String?
  floor          String?
  instructions   String?  @db.Text
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location       Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  orders         Order[]

  @@index([userId, isDefault])
  @@index([locationId])
}

model Order {
  id                    String                @id @default(cuid())
  reference             String                @unique
  userId                String?
  addressId             String?
  locationId            String
  customerName          String
  customerPhone         String
  locationNameSnapshot  String
  addressSnapshot       String                @db.Text
  deliveryNotes         String?               @db.Text
  status                OrderStatus           @default(PENDING)
  paymentMethod         PaymentMethod         @default(CASH_ON_DELIVERY)
  paymentStatus         PaymentStatus         @default(PENDING)
  currency              String                @default("MAD") @db.VarChar(3)
  subtotalMinor         Int
  discountMinor         Int                   @default(0)
  deliveryFeeMinor      Int
  totalMinor            Int
  cancellationReason    String?               @db.Text
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  user                  User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  address               Address?              @relation(fields: [addressId], references: [id], onDelete: SetNull)
  location              Location              @relation(fields: [locationId], references: [id], onDelete: Restrict)
  items                 OrderItem[]
  statusHistory         OrderStatusHistory[]
  assignment            DeliveryAssignment?
  assignmentHistory     DeliveryAssignmentHistory[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([locationId, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id                    String   @id @default(cuid())
  orderId               String
  productId             String?
  productName           String
  productImageUrl       String?
  quantity              Int
  unitPriceMinor        Int
  originalUnitPriceMinor Int?
  discountMinor         Int      @default(0)
  lineTotalMinor        Int
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product               Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  previous    OrderStatus?
  next        OrderStatus
  changedById String?
  note        String?     @db.Text
  createdAt   DateTime    @default(now())
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy   User?       @relation("OrderStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([changedById])
}

model DeliveryAssignment {
  id                String   @id @default(cuid())
  orderId           String   @unique
  deliveryPersonId  String
  assignedById      String?
  assignedAt        DateTime @default(now())
  updatedAt         DateTime @updatedAt
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryPerson    User     @relation("DeliveryPerson", fields: [deliveryPersonId], references: [id], onDelete: Restrict)
  assignedBy        User?    @relation("AssignmentCreatedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([deliveryPersonId, assignedAt])
  @@index([assignedById])
}

model DeliveryAssignmentHistory {
  id                    String   @id @default(cuid())
  orderId               String
  previousPersonId      String?
  nextPersonId          String?
  changedById           String?
  note                  String?  @db.Text
  createdAt             DateTime @default(now())
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousPerson        User?    @relation("PreviousDeliveryPerson", fields: [previousPersonId], references: [id], onDelete: SetNull)
  nextPerson            User?    @relation("NextDeliveryPerson", fields: [nextPersonId], references: [id], onDelete: SetNull)
  changedBy             User?    @relation("AssignmentHistoryActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([changedById])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StoreSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model AuthRateLimit {
  key             String   @id
  attempts        Int      @default(0)
  windowStartedAt DateTime @default(now())
  lockedUntil     DateTime?
  updatedAt       DateTime @updatedAt

  @@index([lockedUntil])
}